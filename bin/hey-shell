#!/usr/bin/env bash
# hey-shell: turn a plain-language request into one shell command via `claude -p`.
#   hey-shell "list running container ids"   -> prints the command, never runs it
#   hey-shell -e "restart postgres"          -> command, a short explanation, and its risk rating (long form: --explain)
#   hey-shell "<command> # <change>"         -> the command, changed as asked (refine a generated command)
#   hey-shell -w "<command>"                 -> explains a command you already have (long form: --what)
#   hey-shell --fix ["<command>"]            -> a corrected version of a failed command; the shell integration
#                                               passes your last command and its exit status when none is given
#   hey-shell --history [text]               -> your last 20 requests and their commands, optionally filtered
#   hey-shell -r "<command>"                 -> prints low|medium|high, then the reason when not low (long form: --risk)
#   hey-shell -c "<command>"                 -> predicts whether the command would fail, without running it (long form: --check)
#   hey-shell [-h]                           -> logo and usage (long form: --help; exit 2 when no request was given)
#   hey-shell -V                             -> the version, read from .claude-plugin/plugin.json (long form: --version)
#   hey-shell -U                             -> updates this checkout to the latest version (long form: --update)
# Env: HEY_SHELL_MODEL (default: haiku), HEY_SHELL_TARGET (default: basename of $SHELL),
#      HEY_SHELL_CLAUDE (default: claude; the CLI to call, also the seam the tests use),
#      HEY_SHELL_CHECK (default: on; 0 = do not predict failure after --explain and on the key binding),
#      HEY_SHELL_COLOR (auto|always|never; NO_COLOR also turns color off),
#      HEY_SHELL_TIMEOUT (default: 30; seconds to wait for Claude),
#      HEY_SHELL_UPDATE_CHECK (default: on; 0 = no "Update available" line),
#      HEY_SHELL_CONTEXT (default: on; 0 = do not tell Claude about installed tools and the project),
#      HEY_SHELL_HISTORY (default: on; 0 = do not log requests to ~/.local/state/hey-shell/history.tsv)
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/risk.sh
source "$root/lib/risk.sh"
# shellcheck source=../lib/check.sh
source "$root/lib/check.sh"
# shellcheck source=../lib/render.sh
source "$root/lib/render.sh"
# shellcheck source=../lib/banner.sh
source "$root/lib/banner.sh"
# shellcheck source=../lib/update.sh
source "$root/lib/update.sh"
# shellcheck source=../lib/context.sh
source "$root/lib/context.sh"

claude_bin="${HEY_SHELL_CLAUDE:-claude}"
out=""

die() { echo "hey-shell: $1" >&2; exit 1; }

# The update notice on stderr, so output that scripts and the key binding capture stays clean. Only on a
# terminal: the key binding shows it through --status instead.
notice() { [ -t 2 ] || return 0; hey_shell_colors; hey_shell_update_notice >&2; }

history_file="${XDG_STATE_HOME:-$HOME/.local/state}/hey-shell/history.tsv"

# log_history <request> <command>: one tab-separated line per answer, kept on this machine only
log_history() {
  [ "${HEY_SHELL_HISTORY:-1}" != 0 ] || return 0
  mkdir -p "$(dirname "$history_file")" 2>/dev/null || return 0
  printf '%s\t%s\t%s\n' "$(date '+%Y-%m-%d %H:%M')" "$(printf '%s' "$1" | tr '\t\n' '  ')" \
    "$(printf '%s' "$2" | tr '\t\n' '  ')" >> "$history_file" 2>/dev/null || true
}

# Turn a failed `claude -p` run into one actionable line.
explain_failure() {
  local text first
  text="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case $text in
    *"/login"*|*"not logged in"*|*"invalid api key"*|*authentication*|*unauthorized*|*401*)
      die "Claude Code is not logged in. Run 'claude' once, complete /login, then try again" ;;
    *"rate limit"*|*"usage limit"*|*429*|*overloaded*|*529*)
      die "Claude is rate limited or overloaded right now. Wait a moment and try again" ;;
    *enotfound*|*econnrefused*|*etimedout*|*"fetch failed"*|*"could not connect"*|*"unable to connect"*|*network*)
      die "Could not reach the Claude API. Check your internet connection or proxy" ;;
  esac
  first="$(printf '%s' "$1" | sed '/^[[:space:]]*$/d' | head -1)"
  die "claude failed${first:+: $first}"
}

# ask_claude <prompt>: sets $out, or exits with a clear message. Gives up after HEY_SHELL_TIMEOUT seconds.
ask_claude() {
  local outf errf markf status=0 err pid limit="${HEY_SHELL_TIMEOUT:-30}"
  case $limit in ''|*[!0-9]*|0) die "HEY_SHELL_TIMEOUT must be a whole number of seconds, like 30" ;; esac
  command -v "$claude_bin" >/dev/null || die "Claude Code CLI not found in PATH. Install it: https://claude.com/claude-code"
  outf="$(mktemp)" errf="$(mktemp)" markf="$(mktemp)"
  rm -f "$markf"
  # text only: no tools or MCP servers, and no saved session cluttering `claude --resume`
  "$claude_bin" -p --model "${HEY_SHELL_MODEL:-haiku}" --tools "" --strict-mcp-config --no-session-persistence \
    "$1" >"$outf" 2>"$errf" &
  pid=$!
  # watchdog: checks once a second, so it never outlives claude by more than a second
  ( i=0
    while [ "$i" -lt "$limit" ]; do sleep 1; kill -0 "$pid" 2>/dev/null || exit 0; i=$((i + 1)); done
    : > "$markf"; kill "$pid" 2>/dev/null ) >/dev/null 2>&1 &
  wait "$pid" || status=$?
  out="$(cat "$outf")" err="$(cat "$errf")"
  rm -f "$outf" "$errf"
  if [ -e "$markf" ]; then
    rm -f "$markf"
    die "Claude did not answer within ${limit}s. Try again, or raise HEY_SHELL_TIMEOUT"
  fi
  [ "$status" -eq 0 ] || explain_failure "$out
$err"
  [ -n "$out" ] || die "Claude returned an empty reply. Try rephrasing the request"
}

# The hse, hsr and hsc aliases put -e, -r or -c first: let `hse -U`, `hsr -h` etc. reach the option itself.
case "${1:-}" in
  --explain|-e|--risk|-r|--check|-c)
    case "${2:-}" in --help|-h|--version|-V|--update|-U) shift ;; esac ;;
esac

case "${1:-}" in
  --help|-h)
    hey_shell_colors
    hey_shell_banner
    hey_shell_usage
    notice
    exit 0 ;;
  --status) # used by the key binding: the boxed command, then "Risk: ... · Check: ..."
    shift
    hey_shell_colors
    hey_shell_risk "$*"
    [ "${HEY_SHELL_CHECK:-1}" = 0 ] || hey_shell_check "$*"
    hey_shell_render_command "$*"
    hey_shell_status
    hey_shell_update_notice
    exit 0 ;;
  --risk|-r)
    shift
    hey_shell_risk "$*"
    printf '%s\n' "$HEY_SHELL_RISK_LEVEL"
    [ "$HEY_SHELL_RISK_LEVEL" = low ] || printf '%s\n' "$HEY_SHELL_RISK_REASON"
    notice
    exit 0 ;;
  --check|-c)
    shift
    hey_shell_check "$*"
    printf '%s\n' "$HEY_SHELL_CHECK_LEVEL"
    [ "$HEY_SHELL_CHECK_LEVEL" = ok ] || printf '%s\n' "$HEY_SHELL_CHECK_REASON"
    notice
    exit 0 ;;
  --version|-V)
    printf 'hey-shell %s\n' "$(hey_shell_version)"
    notice
    exit 0 ;;
  --update|-U)
    hey_shell_update
    exit $? ;;
  --history)
    shift
    hey_shell_colors
    [ -s "$history_file" ] || { echo "no history yet${HEY_SHELL_HISTORY:+ (HEY_SHELL_HISTORY=$HEY_SHELL_HISTORY)}"; exit 0; }
    grep -iF -- "${*:-}" "$history_file" | tail -20 | while IFS=$'\t' read -r when req cmd; do
      printf '%s%s%s  %s\n    %s$%s %s%s%s\n' "$C_MUTED" "$when" "$C_OFF" "$req" "$C_BRAND" "$C_OFF" "$C_CMD" "$cmd" "$C_OFF"
    done
    exit 0 ;;
esac

mode=command
case "${1:-}" in
  --explain|-e) mode=explain; shift ;;
  --what|-w) mode=what; shift ;;
  --fix) mode=fix; shift ;;
esac

case "${1:-}" in
  --) shift ;;
  -*) echo "hey-shell: unknown option '$1' (try --help; put -- before a request that starts with a dash)" >&2; exit 2 ;;
esac

request="$*"
if [ "$mode" = fix ] && [ -z "$request" ]; then
  request="${HEY_SHELL_LAST_CMD:-}"
  [ -n "$request" ] || die "no command to fix: run it right after a failed command (needs the shell integration), or pass it: hey-shell --fix '<command>'"
fi
[ -n "$request" ] || { { hey_shell_colors; hey_shell_banner; hey_shell_usage; } >&2; exit 2; }

case "$(uname -s)" in
  Darwin) os="macOS (BSD userland, not GNU: avoid GNU-only flags)" ;;
  Linux)  if grep -qi microsoft /proc/version 2>/dev/null; then os="Linux (WSL2)"; else os="Linux (GNU userland)"; fi ;;
  *)      os="$(uname -s)" ;;
esac
shell_name="${HEY_SHELL_TARGET:-$(basename "${SHELL:-bash}")}"

context="Environment: $os, $shell_name, current directory $PWD. $(hey_shell_context)"
rules="Always answer with the command that does the task: never reply with a --help or man lookup unless the task asks how to use a tool, and if unsure which tool the user has, pick the most common one. Prefer portable, read-only commands. Do not use sudo or destructive commands (rm, kill, force flags, drops, prune) unless the task explicitly asks for them."
explain_format="line 1 is exactly one $shell_name command (no markdown, no backticks); line 2 is blank; then a plain-language explanation of at most two short sentences"
warning_format="then, only if there is a real risk or precondition, one final line that starts with 'Warning: ' followed by one short sentence (keep the word 'Warning:' in English)"
# -e answers in the language of the request; --what and --fix have no words of yours, so they follow the locale
language="Write the explanation in the same language as the task's words."
locale="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
case ${locale%%_*} in
  ''|C|C.*|POSIX|en) lang_name=English ;;
  tr) lang_name=Turkish ;; de) lang_name=German ;; fr) lang_name=French ;; es) lang_name=Spanish ;;
  pt) lang_name=Portuguese ;; it) lang_name=Italian ;; nl) lang_name=Dutch ;; pl) lang_name=Polish ;;
  ru) lang_name=Russian ;; uk) lang_name=Ukrainian ;; ja) lang_name=Japanese ;; ko) lang_name=Korean ;;
  zh) lang_name=Chinese ;; *) lang_name="the language of the locale ${locale%%.*}" ;;
esac
locale_language="Write the explanation in $lang_name."

# "<command> # <change>": refine a command instead of starting over
task="Task: $request"
case $request in
  *' # '*) task="Start from this command (or request): ${request%% # *} -- and change it like this: ${request#* # }" ;;
esac

case $mode in
  command)
    ask_claude "Reply with exactly one $shell_name command and nothing else: no markdown, no backticks, no explanation. $context $rules $task"
    command_line="$(printf '%s\n' "$out" | sed -e '/^```/d' -e 's/^[[:space:]]*//;s/[[:space:]]*$//' | sed '/^$/d')"
    printf '%s\n' "$command_line"
    log_history "$request" "$command_line"
    notice
    exit 0 ;;
  explain)
    label='SUGGESTED COMMAND'
    ask_claude "Reply in this exact format: $explain_format saying what the command does and what to replace; $warning_format. $language $context $rules $task" ;;
  fix)
    label='SUGGESTED FIX'
    hey_shell_check "$request"
    hint="${HEY_SHELL_LAST_STATUS:+ It exited with status $HEY_SHELL_LAST_STATUS.}"
    [ "$HEY_SHELL_CHECK_LEVEL" = ok ] || hint="$hint A static check says: $HEY_SHELL_CHECK_REASON."
    ask_claude "This command failed: $request$hint Reply in this exact format: $explain_format saying what was wrong and what you changed; $warning_format. If it needs something you cannot know (a file, a service), keep the command and say so. You cannot run commands: never say that you ran or tested one. $locale_language $context $rules"
    request="fix: $request" ;;
  what)
    ask_claude "Explain what this $shell_name command does, for someone about to run it. Reply with a plain-language explanation of at most three short sentences (no markdown, no backticks, do not repeat the command); $warning_format. $locale_language $context Command: $request"
    out="$request

$out" ;;
esac

cleaned="$(printf '%s\n' "$out" | sed -e '/^```/d' -e 's/[[:space:]]*$//' | sed '/./,$!d')"
command_line="$(printf '%s\n' "$cleaned" | head -1 | sed 's/^[[:space:]]*//')"
explanation='' warning=''
while IFS= read -r line; do
  case $line in
    '') ;;
    Warning:*) warning="$(printf '%s %s' "$warning" "${line#Warning:}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')" ;;
    *) explanation="${explanation:+$explanation }$line" ;;
  esac
done <<< "$(printf '%s\n' "$cleaned" | sed '1d')"

hey_shell_risk "$command_line"
[ "${HEY_SHELL_CHECK:-1}" = 0 ] || hey_shell_check "$command_line"
if [ "$mode" != what ]; then
  [ -z "${HEY_SHELL_CMD_FILE:-}" ] || printf '%s' "$command_line" > "$HEY_SHELL_CMD_FILE" # for the shell integration's prefill
  log_history "$request" "$command_line"
fi
hey_shell_colors
hey_shell_render_explain "$command_line" "$explanation" "$warning" "${label:-COMMAND}" "${label:+REVIEW BEFORE RUNNING}"
hey_shell_update_notice
